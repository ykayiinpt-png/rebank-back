# Django
DJANGO_SECRET_KEY=change-me-use-a-long-random-string
DJANGO_SETTINGS_MODULE=ebank.settings
DEBUG=True
ALLOWED_HOSTS=*

# JWT Keys (RS256)
SIGNING_KEY_PATH=/path/to/jwt_private.key
VERIFYING_KEY_PATH=/path/to/jwt_public.key

# HMAC signing secrets
HMAC_SECRET=change-me-otp-hmac-secret
HMAC_API_SECRET=change-me-api-hmac-secret

# Email : Gmail SMTP (use App Password, not your real password)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=xxxx xxxx xxxx xxxx
DEFAULT_FROM_EMAIL=ReBank <your-email@gmail.com>

# Session & Auth
SESSION_COOKIE_AGE=1800
LOGIN_SESSION_EXPIRE_MINUTES=30
RESET_PASSWORD_EXP_MINUTES=5

# OTP
OTP_LENGTH=6
OTP_EXP_DURATION_MINUTES=6

# Registration
REGISTRATION_RESEND_COOLDOWN_MINUTES=5

# JWT Tokens
ACCESS_TOKEN_LIFETIME_MINUTES=300
REFRESH_TOKEN_LIFETIME_DAYS=1

# Initial Users (created via: python manage.py setup_initial_users)
ADMIN_EMAIL=admin@rebank.com
ADMIN_PASSWORD=change-me-admin-password
STAFF_EMAIL=staff@rebank.com
STAFF_PASSWORD=change-me-staff-password
